{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@csc3213-2026-group-b/academic-domain-schemas",
  "version": "1.0.0",
  "description": "Zod schemas for the SCS PDN",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csc3213-2026-group-b/academic-domain-schemas.git"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "changeset": "changeset",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json",
    "version-packages": "changeset version",
    "clean": "rimraf dist",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "knip:depcheck": "knip --dependencies",
    "knip:fix": "knip --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,json,md,yml}": "prettier --write"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
